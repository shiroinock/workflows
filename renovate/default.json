{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "shiroinock のリポジトリで共通の Renovate 設定。各リポジトリの renovate.json から extends で読む。",
  "extends": ["config:recommended", ":timezone(Asia/Tokyo)"],
  "schedule": ["before 9am on monday"],
  "labels": ["依存の更新"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["依存の更新", "セキュリティ"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "shiroinock/workflows を SHA で固定した参照(uses: と workflows_ref)を、main の最新のコミットに上げる",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s*shiroinock/workflows/\\.github/workflows/[^@\\s]+@(?<currentDigest>[0-9a-f]{40})",
        "workflows_ref:\\s*(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "shiroinock/workflows",
      "packageNameTemplate": "https://github.com/shiroinock/workflows",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "minor と patch は1つの PR にまとめる",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "minor と patch の更新"
    },
    {
      "description": "GitHub Actions はまとめて別の PR にする(GITHUB_TOKEN でマージできないので手でマージする)",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Node の大きな版上げは、全リポジトリで揃えて手で上げる",
      "matchDepNames": ["node", "nodejs", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Python の版も、全リポジトリで揃えて手で上げる",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "共通の workflow の参照は customManagers だけで上げる(github-actions の manager と重ねない)",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["shiroinock/workflows"],
      "enabled": false
    },
    {
      "description": "共通の workflow が変わったら、すぐ1つの PR で配る(workflow を変える PR なので手でマージする)",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["shiroinock/workflows"],
      "groupName": "共通の workflow",
      "schedule": ["at any time"]
    }
  ]
}
